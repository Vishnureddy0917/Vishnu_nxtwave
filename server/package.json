{
  "name": "launchloop-server",
  "version": "1.0.0",
  "description": "LaunchLoop AI Backend API and File-based NoSQL Database",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:seed": "tsx src/scripts/seedDb.ts",
    "db:reset": "tsx src/scripts/seedDb.ts --reset",
    "db:backup": "tsx src/scripts/backupDb.ts",
    "db:restore": "tsx src/scripts/restoreDb.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
